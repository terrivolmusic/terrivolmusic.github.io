  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <p class="hero-eyebrow">Producción Audiovisual</p>
    <h1 class="hero-title">Sebastian<br/>Andrade</h1>
    <p class="hero-text">
      Edición con ritmo narrativo, retención y claridad de mensaje.
      Video que funciona para marcas, artistas y creadores — en cualquier formato.
    </p>
    <div class="hero-actions">
      <a href="#trabajos" class="btn btn-primary">Ver trabajos</a>
      <a href="https://wa.me/573102123844" target="_blank" rel="noopener" class="btn btn-ghost">WhatsApp <span>→</span></a>
    </div>
  </section>

  <!-- ===== TRABAJOS ===== -->
  <section class="works" id="trabajos">
    <div class="works-head">
      <h2>Trabajos</h2>
      <p>Una selección de piezas editadas para distintos clientes y objetivos.</p>
    </div>

    <div class="filters">
      <button class="filter active" data-filter="all">Todos</button>
      <button class="filter" data-filter="reels">Reels & Social</button>
      <button class="filter" data-filter="branded">Branded & Corporativo</button>
      <button class="filter" data-filter="music">Música & Videoclips</button>
    </div>

    <div class="grid" id="grid"><!-- cards inyectadas por JS --></div>
  </section>

  <!-- ===== SERVICIOS ===== -->
  <section class="services" id="servicios">
    <h2>Servicios</h2>
    <div class="services-grid">
      <div class="service">
        <h3>Reels & Contenido Vertical</h3>
        <p>Edición optimizada para mobile: cortes precisos, ritmo de retención y mensaje claro. Ideal para Instagram, TikTok y YouTube Shorts.</p>
      </div>
      <div class="service">
        <h3>Branded Content & Corporativo</h3>
        <p>Reels de marca, promos y piezas comerciales que comunican el valor de tu negocio con un acabado profesional.</p>
      </div>
      <div class="service">
        <h3>Videoclips & Música</h3>
        <p>Edición musical con atmósfera, color y montaje que elevan tus canciones, shows y proyectos artísticos.</p>
      </div>
      <div class="service">
        <h3>Films & Promocionales</h3>
        <p>Piezas largas, documentales cortos y contenido de historia con narrativa cuidada y calidad de broadcast.</p>
      </div>
    </div>
  </section>

