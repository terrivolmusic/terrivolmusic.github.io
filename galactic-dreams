        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Header */
        header {
            text-align: center;
            margin-bottom: 60px;
            padding: 40px 20px;
            background: rgba(22, 22, 30, 0.8);
            border-radius: 20px;
            border: 1px solid rgba(138, 43, 226, 0.3);
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(90deg, #8a2be2, #00f2ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .tagline {
            color: #888;
            font-size: 1.1rem;
        }

        /* Main Beat Section */
        .beat-showcase {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        @media (max-width: 768px) {
            .beat-showcase {
                grid-template-columns: 1fr;
            }
        }

        /* Cover Art */
        .cover-art {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(138, 43, 226, 0.4);
            aspect-ratio: 1;
        }

        .cover-art img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .cover-art:hover img {
            transform: scale(1.05);
        }

        .cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(0, 242, 255, 0.2));
            pointer-events: none;
        }

        /* Beat Info */
        .beat-info h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #fff, #00f2ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .beat-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .meta-tag {
            background: rgba(138, 43, 226, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            color: #00f2ff;
            border: 1px solid rgba(138, 43, 226, 0.5);
        }

        /* Audio Player */
        .audio-player {
            background: rgba(22, 22, 30, 0.9);
            padding: 30px;
            border-radius: 20px;
            border: 2px solid rgba(138, 43, 226, 0.3);
            margin-bottom: 30px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .play-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8a2be2, #00f2ff);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s;
        }

        .play-btn:hover {
            transform: scale(1.1);
        }

        .play-btn svg {
            width: 30px;
            height: 30px;
            fill: white;
            margin-left: 5px;
        }

        .progress-bar {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
        }

        .progress {
            height: 100%;
            background: linear-gradient(90deg, #8a2be2, #00f2ff);
            width: 0%;
            transition: width 0.1s;
        }

        .time-display {
            color: #888;
            font-family: monospace;
            font-size: 0.9rem;
        }

        /* License Cards */
