<style>
:root{
  --bg:#050507; --line:rgba(255,255,255,.10);
  --lime:#baff3f; --mag:#ff3ddc; --ice:#7df3ff;
  --text:#ffffff; --muted:#b8b4c6; --dim:#8b8798;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:'Space Grotesk',sans-serif;overflow-x:hidden}
#stars{position:fixed;inset:0;z-index:0}
.nebula{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(ellipse 55% 40% at 15% 0%,rgba(255,61,220,.14),transparent),
             radial-gradient(ellipse 45% 35% at 90% 80%,rgba(186,255,63,.08),transparent),
             radial-gradient(ellipse 35% 25% at 60% 40%,rgba(125,243,255,.06),transparent);}
.wrap{position:relative;z-index:1;max-width:760px;margin:0 auto;padding:44px 22px 90px}

header{display:flex;justify-content:space-between;align-items:center;margin-bottom:56px}
.logo{font-family:'Unbounded';font-weight:800;font-size:13px;letter-spacing:.25em;color:#fff}
.logo span{color:var(--lime)}
.badge{font-size:9px;letter-spacing:.35em;color:var(--lime);border:1px solid rgba(186,255,63,.4);padding:7px 16px}

.ticker{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px 0;margin-bottom:60px}
.ticker-inner{display:flex;gap:56px;white-space:nowrap;animation:tick 28s linear infinite;font-size:9px;letter-spacing:.4em;color:var(--dim)}
@keyframes tick{to{transform:translateX(-50%)}}

.hero{position:relative;margin-bottom:60px}
.for{display:inline-block;font-size:10px;letter-spacing:.35em;color:var(--lime);border:1px solid rgba(186,255,63,.45);padding:10px 20px;margin-bottom:22px}
.for b{color:#fff}
.kicker{font-size:10px;letter-spacing:.45em;color:var(--mag);margin-bottom:18px}
.hero h1{font-family:'Unbounded';font-weight:800;font-size:clamp(24px,6vw,42px);line-height:1.15;text-transform:uppercase;margin-bottom:22px;color:#fff;text-shadow:0 0 40px rgba(186,255,63,.12)}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--lime),var(--mag));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero h1 b{color:var(--mag);-webkit-text-fill-color:var(--mag)}
.hero p{color:var(--muted);font-size:14px;font-weight:300;max-width:520px;line-height:1.8;margin-bottom:26px}
.hero p b{color:#fff;font-weight:500}
.hp{display:inline-block;font-size:10px;letter-spacing:.3em;color:var(--lime);border:1px solid rgba(186,255,63,.4);padding:9px 18px;margin-bottom:14px}
.network{font-size:9px;letter-spacing:.3em;color:var(--dim);line-height:2}
.orb{position:absolute;top:-10px;right:0;width:110px;height:110px;border-radius:50%;
  background:radial-gradient(circle at 30% 30%,var(--mag),#12060f 70%);
  box-shadow:0 0 90px rgba(255,61,220,.5), inset -14px -14px 30px rgba(0,0,0,.6);
  animation:float 7s ease-in-out infinite}
.orb::after{content:"";position:absolute;inset:-16px -34px;border:1px solid rgba(186,255,63,.4);border-radius:50%;transform:rotate(-16deg) scaleY(.32)}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

.section{display:flex;align-items:center;gap:18px;margin:70px 0 26px}
.section h2{font-family:'Unbounded';font-weight:500;font-size:12px;letter-spacing:.4em;color:var(--lime)}
.section .rule{flex:1;height:1px;background:var(--line)}

.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line)}
.stat{padding:24px 10px;text-align:center;border-right:1px solid var(--line)}
.stat:last-child{border-right:none}
.stat b{display:block;font-family:'Unbounded';font-weight:800;font-size:clamp(16px,4vw,26px);color:var(--lime);margin-bottom:8px}
.stat .big{color:var(--mag);font-size:clamp(20px,5vw,30px)}
.stat span{font-size:8px;letter-spacing:.3em;color:var(--dim)}

.arsenal-hero{border:1px solid var(--line);padding:40px 22px;text-align:center;background:linear-gradient(180deg,rgba(255,61,220,.10),rgba(186,255,63,.04));margin-bottom:20px;position:relative;overflow:hidden}
.arsenal-hero .num{font-family:'Unbounded';font-weight:800;font-size:clamp(56px,14vw,96px);background:linear-gradient(180deg,var(--lime),var(--mag));-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1;letter-spacing:-.02em;filter:drop-shadow(0 0 30px rgba(186,255,63,.25))}
.arsenal-hero .num sup{font-size:.35em;color:var(--lime);-webkit-text-fill-color:var(--lime);vertical-align:super;letter-spacing:.2em}
.arsenal-hero .lbl{font-size:10px;letter-spacing:.5em;color:var(--muted);margin-top:14px}
.arsenal-hero::before,.arsenal-hero::after{content:"";position:absolute;width:1px;background:linear-gradient(180deg,transparent,var(--lime),transparent);top:0;bottom:0}
.arsenal-hero::before{left:0}
.arsenal-hero::after{right:0}

/* PLAY ALL */
.playall-wrap{text-align:center;margin-bottom:22px}
#playAll{font-family:'Unbounded';font-size:11px;letter-spacing:.3em;color:var(--lime);background:transparent;border:1px solid var(--lime);padding:16px 40px;cursor:pointer;transition:.35s}
#playAll:hover{background:var(--lime);color:var(--bg);box-shadow:0 0 40px rgba(186,255,63,.4)}
.session-note{margin-top:12px;font-size:9px;letter-spacing:.3em;color:var(--dim)}

.beat{background:rgba(255,255,255,.03);border:1px solid var(--line);padding:22px;margin-bottom:12px;display:flex;align-items:center;gap:20px;position:relative;overflow:hidden;transition:.35s}
.beat:hover{border-color:rgba(186,255,63,.45)}
.beat.playing{border-color:rgba(255,61,220,.6)}
.beat.ended{border-color:rgba(186,255,63,.5)}
.ch{font-family:'Unbounded';font-weight:800;font-size:20px;color:var(--dim);min-width:44px}
.beat.playing .ch{color:var(--mag)}
.play{width:60px;height:60px;min-width:60px;border:1px solid var(--line);background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.3s}
.play:hover{border-color:var(--lime);box-shadow:0 0 26px rgba(186,255,63,.35)}
.play svg{width:20px;height:20px;fill:var(--lime)}
.info{flex:1}
.info h3{font-family:'Unbounded';font-weight:500;font-size:15px;letter-spacing:.12em;margin-bottom:8px;text-transform:uppercase;color:#fff}
.tags{display:flex;gap:8px;flex-wrap:wrap}
.tag{font-size:9px;letter-spacing:.15em;color:#c9c5da;border:1px solid rgba(255,255,255,.16);padding:4px 10px}
.tag.city{color:var(--lime);border-color:rgba(186,255,63,.4)}
.tag.one{color:var(--ice);border-color:rgba(125,243,255,.4)}
.tag.b808{color:#ffb1ec;border-color:rgba(255,61,220,.45)}
.viz{width:120px;height:34px}
.acquire{font-size:9px;letter-spacing:.3em;color:#fff;text-decoration:none;border:1px solid var(--line);padding:12px 20px;transition:.3s;white-space:nowrap}
.acquire:hover{border-color:var(--lime);color:var(--lime)}
.beat.ended .acquire{border-color:var(--lime);color:var(--lime);animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 rgba(186,255,63,0)}50%{box-shadow:0 0 22px rgba(186,255,63,.5)}}
.progress{position:absolute;bottom:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--lime),var(--mag))}
.pnote{display:none;position:absolute;bottom:10px;right:16px;font-size:8px;letter-spacing:.25em;color:var(--lime)}
.beat.ended .pnote{display:block}
.note{font-size:10px;letter-spacing:.2em;color:var(--dim);text-align:center;margin-top:26px;line-height:2}

.gets{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.get{border:1px solid var(--line);padding:20px;background:rgba(255,255,255,.03)}
.get .n{font-family:'Unbounded';font-size:9px;color:var(--lime);letter-spacing:.2em}
.get b{display:block;font-family:'Unbounded';font-weight:500;font-size:11px;letter-spacing:.2em;color:var(--ice);margin:10px 0 8px}
.get span{font-size:11px;color:var(--muted);line-height:1.7;font-weight:300}

.backs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.back{border:1px solid rgba(255,61,220,.3);padding:22px 16px;text-align:center;background:linear-gradient(180deg,rgba(255,61,220,.08),transparent)}
.back .ico{font-size:20px;margin-bottom:12px}
.back b{display:block;font-family:'Unbounded';font-weight:500;font-size:10px;letter-spacing:.25em;color:#fff;margin-bottom:10px}
.back span{font-size:10px;color:var(--muted);line-height:1.7;font-weight:300}

.full-arsenal{border:1px solid rgba(186,255,63,.4);background:linear-gradient(180deg,rgba(186,255,63,.07),transparent);padding:32px 24px;margin-bottom:20px;text-align:center}
.full-arsenal .tag-top{font-size:9px;letter-spacing:.5em;color:var(--lime);margin-bottom:16px}
.full-arsenal h3{font-family:'Unbounded';font-weight:800;font-size:clamp(18px,5vw,28px);text-transform:uppercase;letter-spacing:.1em;margin-bottom:14px;color:#fff}
.full-arsenal h3 em{font-style:normal;background:linear-gradient(90deg,var(--lime),var(--mag));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.full-arsenal p{color:var(--muted);font-size:13px;font-weight:300;line-height:1.8;max-width:460px;margin:0 auto 24px}
.full-arsenal .btn-arsenal{display:inline-block;font-family:'Unbounded';font-size:10px;letter-spacing:.35em;text-decoration:none;color:var(--lime);border:1px solid var(--lime);padding:14px 32px;transition:.35s}
.full-arsenal .btn-arsenal:hover{background:var(--lime);color:var(--bg)}

.archive{background:rgba(255,255,255,.03);border:1px solid var(--line);padding:20px 22px;margin-bottom:12px;display:flex;align-items:center;gap:18px}
.archive .lock{width:52px;height:52px;min-width:52px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--dim)}
.archive h3{font-family:'Unbounded';font-weight:500;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.archive .count{font-family:'Unbounded';font-weight:800;font-size:20px;color:var(--lime);margin-left:auto;padding-right:16px}
.demande{font-size:9px;letter-spacing:.3em;color:var(--lime);border:1px solid rgba(186,255,63,.4);padding:12px 20px;text-decoration:none;white-space:nowrap;transition:.3s}
.demande:hover{background:var(--lime);color:var(--bg)}

.cta{margin-top:80px;border-top:1px solid var(--line);padding-top:60px}
.cta h2{font-family:'Unbounded';font-weight:800;font-size:clamp(20px,5vw,30px);text-transform:uppercase;margin-bottom:14px;color:#fff}
.cta p{color:var(--muted);font-size:14px;font-weight:300;line-height:1.8;max-width:520px;margin-bottom:32px}
.btn{display:inline-block;font-family:'Unbounded';font-size:11px;letter-spacing:.35em;text-decoration:none;color:var(--lime);border:1px solid var(--lime);padding:18px 44px;transition:.35s}
.btn:hover{background:var(--lime);color:var(--bg);box-shadow:0 0 44px rgba(186,255,63,.4)}
.cta-alt{margin-top:22px;font-size:10px;letter-spacing:.2em;color:var(--dim)}
.cta-alt a{color:var(--muted);text-decoration:none;border-bottom:1px solid var(--dim)}
footer{margin-top:90px;text-align:center;font-size:9px;letter-spacing:.4em;color:var(--dim)}
@media(max-width:680px){.orb{display:none}.viz{display:none}.beat{flex-wrap:wrap}.acquire{width:100%;text-align:center}.ch{min-width:34px}.stats{grid-template-columns:repeat(2,1fr)}.stat:nth-child(2){border-right:none}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}.gets{grid-template-columns:1fr}.backs{grid-template-columns:1fr}.archive{flex-wrap:wrap}.archive .count{margin-left:0;padding-right:0}.demande{width:100%;text-align:center}}
</style>
</head>
