// Audio engine + MODO SESIÓN (auto-next)
let audio = new Audio(), ctx=null, analyser=null, dataArr=null, current=null;
function ensureCtx(){
  if(ctx) return;
  ctx = new (window.AudioContext||window.webkitAudioContext)();
  analyser = ctx.createAnalyser(); analyser.fftSize=64; analyser.smoothingTimeConstant=.82;
  const src = ctx.createMediaElementSource(audio);
  src.connect(analyser); analyser.connect(ctx.destination);
  dataArr = new Uint8Array(analyser.frequencyBinCount);
}
document.getElementById("playAll").onclick = ()=> toggle(0);
document.querySelectorAll(".play").forEach(btn=> btn.onclick = ()=> toggle(+btn.closest(".beat").dataset.i));

function toggle(i){
  const card = document.querySelector(`.beat[data-i="${i}"]`);
  if(current===i && !audio.paused){ audio.pause(); return; }
  ensureCtx();
  if(ctx.state==="suspended") ctx.resume();
  if(current!==null && current!==i) reset(document.querySelector(`.beat[data-i="${current}"]`));
  const b = BEATS[i];
  if(!audio.src.includes(b.file)){ audio.src = b.file; }
  audio.currentTime = 0;
  card.classList.remove("ended");
  current = i; card.classList.add("playing");
  card.querySelector(".ic-play").style.display="none";
  card.querySelector(".ic-pause").style.display="block";
  audio.play();
  audio.ontimeupdate = ()=>{
    const el = audio.currentTime;
    card.querySelector(".progress").style.width = Math.min(100, el/PREVIEW_SECONDS*100)+"%";
    if(el >= PREVIEW_SECONDS) endPreview(card);
  };
  audio.onended = ()=>{ reset(card); autoNext(); };
}
function autoNext(){
  if(current===null) return;
  const n = current+1;
  if(n < BEATS.length) toggle(n);
}
function endPreview(card){
  audio.pause();
  card.classList.remove("playing");
  card.classList.add("ended");
  card.querySelector(".ic-play").style.display="block";
  card.querySelector(".ic-pause").style.display="none";
  card.querySelector(".progress").style.width="100%";
  card.querySelector(".viz").getContext("2d").clearRect(0,0,120,34);
  autoNext();
}
function reset(c){
  if(!c) return;
  c.classList.remove("playing","ended");
  c.querySelector(".ic-play").style.display="block";
  c.querySelector(".ic-pause").style.display="none";
  c.querySelector(".progress").style.width="0%";
  c.querySelector(".viz").getContext("2d").clearRect(0,0,120,34);
}

(function loop(){
  requestAnimationFrame(loop);
  if(!analyser || current===null || audio.paused) return;
  analyser.getByteFrequencyData(dataArr);
  const c = document.querySelector(`.beat[data-i="${current}"] .viz`);
  const g = c.getContext("2d"); g.clearRect(0,0,120,34);
  const bars=18, w=120/bars;
  for(let i=0;i<bars;i++){
    const v=dataArr[i]/255, h=Math.max(2,v*34);
    g.fillStyle=`rgba(186,255,63,${.25+v*.75})`;
    g.fillRect(i*w+1,34-h,w-2,h);
  }
})();

const cv=document.getElementById("stars"),cx=cv.getContext("2d");let S=[];
function rs(){cv.width=innerWidth;cv.height=innerHeight;S=Array.from({length:130},()=>({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*1.3+.2,a:Math.random()*6.28,s:Math.random()*.015+.004}));}
rs();addEventListener("resize",rs);
(function d(){cx.clearRect(0,0,cv.width,cv.height);S.forEach(st=>{st.a+=st.s;cx.globalAlpha=Math.abs(Math.sin(st.a))*.8;cx.fillStyle="#f4ffe6";cx.beginPath();cx.arc(st.x,st.y,st.r,0,7);cx.fill();});requestAnimationFrame(d);})();
</script>
